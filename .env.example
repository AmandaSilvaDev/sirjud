# Copie para .env (não versionado) no desenvolvimento local.
# No Railway, cadastre estas variáveis em cada ambiente. Sem valores reais aqui.
# Gere chaves com: uv run python manage.py generate_keys

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ENV=development
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# Local: Postgres do docker-compose. Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://sirjud:sirjud@127.0.0.1:5432/sirjud

# Criptografia de CPF/CNPJ (id:chave_base64; a primeira cifra, as demais só decifram)
FIELD_ENCRYPTION_KEYS=
SEARCH_HMAC_KEY=

# Opcionais
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
